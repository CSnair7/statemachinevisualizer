    "import graphviz\n",
    "dot = graphviz.Digraph(comment='My Flowchart', format='jpeg')\n",
    "\n",
    "# 2. Add nodes and edges\n",
    "dot.node('A', 'Start')\n",
    "dot.node('B', 'Process')\n",
    "dot.node('C', 'End')\n",
    "\n",
    "dot.edge('A', 'B')\n",
    "dot.edge('B', 'C')\n",
    "\n",
    "# 3. Render and save the image\n",
    "# This creates 'process_graph.gv' (source) and 'process_graph.gv.png' (image)\n",
    "dot.render(filename='process_graph.gv', directory='output_directory', view=True)"
   ]
