    "import graphviz\n",
    "dot = graphviz.Digraph('G', filename=\"Graph.png\")\n",
    "\n",
    "dot.attr('node', shape='square')\n",
    "# Define all data in one place\n",
    "nodes = [('A', 'Alpha'), ('B', 'Beta'), ('C', 'Gamma')]\n",
    "edges = [('A', 'B'), ('B', 'C'), ('A', 'C')]\n",
    "\n",
    "# Declare nodes in a brief loop\n",
    "for node_id, label in nodes:\n",
    "    dot.node(node_id, label)\n",
    "\n",
    "# Mass declare edges with a single method call\n",
    "dot.edges(edges)\n",
    "dot.render(filename='process_graph', directory='output_directory', view=True)"
   ]
